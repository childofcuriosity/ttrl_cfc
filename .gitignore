# --- BIG FILES / FOLDERS TO IGNORE ---
# 194 GB: model checkpoints
checkpoints/
/checkpoints/

# 70 GB: language model weights
llms/
/llms/

# 1.9 GB: validation data
covalidate/

# 204 MB: datasets (above the 100 MB file limit)
data/
/data/

# 169 MB: WandB logs
wandb/

# 6.2 MB: generated outputs
outputs/

